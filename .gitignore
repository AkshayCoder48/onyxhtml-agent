```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarnrc
package-lock.json
yarn.lock
.nuxt/
.next/
.vercel/

# Build outputs
dist/
build/
.out/
.output/
_coverage/
.nyc_output/
jest-coverage/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.DS_Store
._*

# Coverage
coverage/
.nyc_output/
istanbul/
.lcovonly

# Compiled JavaScript
lib/
es/
esm/
cjs/
umd/

# Lock files for other package managers
pnpm-lock.yaml
bun.lockb

# Browser extensions
*.crx
*.xpi
*.nex

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```