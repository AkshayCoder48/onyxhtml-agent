+          emit({
+            type: "tool.result",
+            messageId: s.messageId,
+            toolCallId: tc.callId,
+            status,
+            result,
+            error: errorMsg2,
+            label,
+            detail,
+          });
+          emit({
+            type: "tool.complete",
+            messageId: s.messageId,
+            toolCallId: tc.callId,
+          });
