-          ctx.send({ type: "thinking.delta", messageId, delta: ev.content });
-        } else if (ev.type === "content") {
-          // PRD §7, §12: emit text.delta immediately — character-by-character
-          // as the provider sends it. The client appends to the streaming
-          // content segment.
