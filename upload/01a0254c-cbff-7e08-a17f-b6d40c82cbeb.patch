-
-generator client {
-  provider = "prisma-client-js"
-}
-
-datasource db {
-  provider = "sqlite"
-  url      = env("DATABASE_URL")
-}
-
-model Workspace {
-  id        String   @id @default(cuid())
-  name      String
-  activeFile String?
-  template  String   @default("blank")
-  settings  String   @default("{}") // JSON: editor/preview settings overrides
-  createdAt DateTime @default(now())
-  updatedAt DateTime @updatedAt
-
-  files File[]
-  chats Chat[]
-}
-
-model File {
-  id          String   @id @default(cuid())
-  workspaceId String
-  path        String   // relative path, e.g. "index.html" or "assets/logo.png"
-  content     String   @default("")
-  isBinary    Boolean  @default(false)
-  createdAt   DateTime @default(now())
-  updatedAt   DateTime @updatedAt
-
-  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
-
-  @@unique([workspaceId, path])
-  @@index([workspaceId])
-}
-
-model Chat {
-  id          String   @id @default(cuid())
-  workspaceId String
-  title       String   @default("New Chat")
-  createdAt   DateTime @default(now())
-  updatedAt   DateTime @updatedAt
-
-  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
-  messages  Message[]
-}
-
-model Message {
-  id        String   @id @default(cuid())
-  chatId    String
-  role      String   // "user" | "assistant"
-  segments  String   @default("[]") // JSON: array of message segments
-  createdAt DateTime @default(now())
-
-  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
-
-  @@index([chatId])
-}
-
-model Provider {
-  id        String   @id @default(cuid())
-  name      String
-  baseURL   String
-  apiKey    String?
-  model     String
-  isActive  Boolean  @default(false)
-  createdAt DateTime @default(now())
-  updatedAt DateTime @updatedAt
-}
-
-model AppSetting {
-  key   String @id
-  value String
-}
diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..7ad8f7e
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,111 @@
+/* OnyxHTML Agent — Service Worker
+ *
+ * Provides offline app-shell caching:
+ *   - On install, pre-caches the core shell (HTML, CSS, JS chunks).
+ *   - On fetch, same-origin GET requests use a "stale-while-revalidate"
+ *     strategy so the UI loads instantly even without a network.
+ *   - Cross-origin requests (LLM providers, CDN assets) pass through
+ *     untouched.
+ *
+ * This file lives in /public so Next.js serves it from the site root
+ * (/sw.js), which is required for a service worker to control the whole
+ * origin. It is plain ES5-ish JavaScript on purpose: service workers are
+ * NOT processed by the bundler, so no TypeScript / import statements here.
+ */
+
