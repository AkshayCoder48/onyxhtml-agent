-        // client's ToolStore transitions the card out of the running state.
-        ctx.send({
-          type: "tool.result",
-          messageId,
-          toolCallId: r.callId,
-          status: seg.status,
-          result: r.result,
-          error: r.error,
-          label: seg.label,
-          detail: seg.detail,
