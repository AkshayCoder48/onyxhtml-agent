// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  activeFile String?
  template  String   @default("blank")
  settings  String   @default("{}") // JSON: editor/preview settings overrides
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]
  chats Chat[]
}

model File {
  id          String   @id @default(cuid())
  workspaceId String
  path        String   // relative path, e.g. "index.html" or "assets/logo.png"
  content     String   @default("")
  isBinary    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, path])
  @@index([workspaceId])
}

model Chat {
  id          String   @id @default(cuid())
  workspaceId String
  title       String   @default("New Chat")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String   // "user" | "assistant"
  segments  String   @default("[]") // JSON: array of message segments
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model Provider {
  id        String   @id @default(cuid())
  name      String
  baseURL   String
  apiKey    String?
  model     String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key   String @id
  value String
}
